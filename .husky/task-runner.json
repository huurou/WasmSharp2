{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "auto-format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "WasmSharp2.slnx", "--severity", "info", "--include", "${staged}"],
      "include": [
        "src/**/*.cs",
        "tests/**/*.cs",
        "tools/**/*.cs"
      ]
    }
  ]
}
