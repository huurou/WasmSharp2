<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.66.16" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WasmSharp.Generators\WasmSharp.Generators.csproj" />
    <EmbeddedResource
      Include="..\..\src\WasmSharp\Instructions\InstructionAttribute.cs;..\..\src\WasmSharp\Instructions\OpcodeKey.cs;..\..\src\WasmSharp\Instructions\ImmediateKind.cs;..\..\src\WasmSharp\Instructions\StackEffectKind.cs;..\..\src\WasmSharp\Instructions\ValidationRule.cs"
      LogicalName="InstructionContracts.%(Filename)%(Extension)"
    />
    <EmbeddedResource
      Include="..\..\src\WasmSharp\Execution\ExecutionResult.cs;..\..\src\WasmSharp\Execution\Instruction.cs"
      LogicalName="ExecutionContracts.%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
