<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.66.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\WasmSharp.TestSuiteRunner\WasmSharp.TestSuiteRunner.csproj" />
    <ProjectReference
      Include="Fixtures\ConverterFixture\ConverterFixture.csproj"
      ReferenceOutputAssembly="false"
    />
    <Compile Remove="Fixtures\ConverterFixture\**\*.cs" />
    <None Remove="Fixtures\ConverterFixture\**\*" />
    <None Update="Fixtures\Data\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyConverterFixture" AfterTargets="Build">
    <MSBuild
      Projects="Fixtures\ConverterFixture\ConverterFixture.csproj"
      Targets="GetTargetPath"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
    >
      <Output TaskParameter="TargetOutputs" ItemName="ConverterFixtureAssembly" />
    </MSBuild>
    <PropertyGroup>
      <ConverterFixtureOutput>@(ConverterFixtureAssembly->'%(RootDir)%(Directory)')</ConverterFixtureOutput>
    </PropertyGroup>
    <ItemGroup>
      <ConverterFixtureFiles Include="$(ConverterFixtureOutput)**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ConverterFixtureFiles)"
      DestinationFiles="@(ConverterFixtureFiles->'$(OutDir)ConverterFixture/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
    >
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
</Project>
