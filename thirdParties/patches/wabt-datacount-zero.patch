 using CodeMetadataSections =
     std::unordered_map<std::string_view, CodeMetadataSection>;
 
+bool HasDataSegmentInstruction(const Module& module) {
+  struct Finder : ExprVisitor::DelegateNop {
+    bool found = false;
+
+    Result OnDataDropExpr(DataDropExpr*) override {
+      found = true;
+      return Result::Ok;
+    }
+
+    Result OnMemoryInitExpr(MemoryInitExpr*) override {
+      found = true;
+      return Result::Ok;
+    }
+  } finder;
+
+  ExprVisitor visitor(&finder);
+  for (size_t i = module.num_func_imports; i < module.funcs.size(); ++i) {
+    (void)visitor.VisitFunc(module.funcs[i]);
+    if (finder.found) {
+      return true;
+    }
+  }
+  return false;
+}
+
 class BinaryWriter {
   WABT_DISALLOW_COPY_AND_ASSIGN(BinaryWriter);
 
